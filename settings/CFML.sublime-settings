{
	// syntax settings replace Default's triggers rather than adding to them,
	// so the first two repeat Default's (with "<" kept out of script blocks)
	"auto_complete_triggers": [
		{"selector": "text.html - source, text.xml", "characters": "<"},
		{"selector": "punctuation.accessor", "rhs_empty": true},
		{"selector": "source.cfml.script - string", "characters": "."},
		{"selector": "source.cfml.script meta.function-call.support.createcomponent.cfml string.quoted", "characters": "."},
		{"selector": "meta.class.inheritance.cfml", "characters": "."},
		{"selector": "meta.tag.cfml - string - source.cfml.script", "characters": " "},
		{"selector": "meta.tag.custom.cfml - string - source.cfml.script", "characters": ": "},
		{"selector": "meta.tag.script.cfml - string, meta.tag.script.cf.cfml - string, meta.class.declaration.cfml - string", "characters": " "}
	]
}
