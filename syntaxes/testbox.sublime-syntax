%YAML 1.2
---
name: TestBox
scope: testbox
hidden: true
contexts:
  main:
    - match: '^\|(?=\s\d+\s+\|)'
      push: [skipped, error, failure, success]
    - match: 'Pass:|\[Passed:'
      push: success
    - match: 'Failures:|\[Failed:'
      push: failure
    - match: 'Errors:|\[Errors:'
      push: error
    - match: 'Skipped:|\[Skipped:'
      push: skipped
    - match: \(([+P])\)
      captures:
        1: markup.inserted.testbox
    - match: \((!)\)
      captures:
        1: markup.changed.testbox
    - match: \((X)\)
      captures:
        1: markup.deleted.testbox
    - match: \((-)\)
      captures:
        1: markup.ignored.testbox
    - match: \S.*testbox[\\/]system.*:\d+$
      scope: markup.italic.testbox
    - match: \S.*:\d+$
      scope: markup.bold.testbox
  success:
    - match: '[1-9]\d*'
      scope: markup.inserted.testbox
    - match: \S
      pop: true
  failure:
    - match: '[1-9]\d*'
      scope: markup.changed.testbox
    - match: \S
      pop: true
  error:
    - match: '[1-9]\d*'
      scope: markup.deleted.testbox
    - match: \S
      pop: true
  skipped:
    - match: '[1-9]\d*'
      scope: markup.ignored.testbox
    - match: \S
      pop: true
